{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && node lib/error-tracking/source-map-upload.js",
    "build:analyze": "ANALYZE=true next build",
    "build:check-size": "size-limit",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:unit": "jest --testPathPattern=\"src/|utils/\"",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:a11y": "npm run test:a11y:pages && npm run test:a11y:components",
    "test:a11y:pages": "playwright test e2e/accessibility.spec.ts",
    "test:a11y:components": "jest --runInBand --config jest.config.js --selectProjects components --testPathPattern=accessibility.test.tsx",
    "test:a11y:report": "node scripts/a11y-report.mjs",
    "bundle:analyze": "node scripts/bundle-analyzer.mjs"
  },
  "dependencies": {
    "@stellarveriphy/shared": "workspace:*",
    "@stellar/freighter-api": "6.0.1",
    "@stellar/stellar-sdk": "^14.5.0",
    "@tanstack/react-query": "5.62.7",
    "clsx": "2.1.1",
    "fast-xml-parser": "4.4.1",
    "framer-motion": "^10.18.0",
    "geist": "^1.7.1",
    "jspdf": "^2.5.2",
    "lucide-react": "^0.263.1",
    "next": "15.0.0",
    "prismjs": "^1.30.0",
    "qrcode": "^1.5.4",
    "react": "^18",
    "react-dom": "^18",
    "react-hook-form": "^7.54.2",
    "react-icons": "^5.6.0",
    "recharts": "^2.10.0",
    "swagger-ui-react": "^5.18.2",
    "tailwind-merge": "2.5.4",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@eslint/eslintrc": "3.3.1",
    "@next/bundle-analyzer": "15.0.0",
    "@playwright/test": "1.49.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.5.2",
    "@types/jest": "29.5.14",
    "@types/node": "^20",
    "@types/prismjs": "^1.26.6",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/swagger-ui-react": "^4.19.0",
    "autoprefixer": "^10.4.20",
    "eslint": "9.27.0",
    "eslint-config-next": "15.0.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "jest": "^29.7.0",
    "jest-axe": "^10.0.0",
    "jest-environment-jsdom": "^29.7.0",
    "postcss": "^8",
    "size-limit": "^11.1.4",
    "tailwindcss": "^3",
    "ts-jest": "^29.2.6",
    "typescript": "^5",
    "wait-on": "^8.0.1"
  },
  "size-limit": [
    { "path": ".next/static/chunks/main-*.js", "limit": "300KB", "gzip": true },
    { "path": ".next/static/css/global-*.css", "limit": "50KB", "gzip": true }
  ]
}
