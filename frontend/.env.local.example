# Canonical site URL, used to resolve absolute Open Graph / Twitter Card image URLs
NEXT_PUBLIC_APP_URL=https://stellarveriphy.com

# Stellar Network RPC URLs
NEXT_PUBLIC_TESTNET_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_MAINNET_RPC_URL=https://mainnet.stellar.validationcloud.io/v1/soroban/rpc
NEXT_PUBLIC_FUTURENET_RPC_URL=https://rpc-futurenet.stellar.org

# Active network (testnet | mainnet | futurenet)
NEXT_PUBLIC_NETWORK=testnet

# Overrides the network passphrase reported to wallet adapters (Albedo, xBull)
# that cannot query the connected network directly. Optional; defaults to the
# Testnet passphrase.
NEXT_PUBLIC_NETWORK_PASSPHRASE=

# Soroban contract addresses
NEXT_PUBLIC_ORACLE_CONTRACT_ID=
NEXT_PUBLIC_PROVENANCE_CONTRACT_ID=
NEXT_PUBLIC_REGISTRY_CONTRACT_ID=

# Set to "true" to use the in-memory mock wallet service instead of a real
# wallet extension (Freighter/Albedo/xBull). Useful for local development
# and e2e tests. Optional; defaults to disabled.
NEXT_PUBLIC_MOCK_WALLET=
