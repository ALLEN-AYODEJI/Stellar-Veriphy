                }
            ]
        },
        {
            "name": "Transaction History",
            "short_name": "Transactions",
            "description": "View your transaction history",
            "url": "/transactions",
            "icons": [
                {
                    "src": "/icons/shortcut-transactions.png",
                    "sizes": "96x96",
                    "type": "image/png"
                }
            ]
        },
        {
            "name": "Create Manifest",
            "short_name": "Manifest",
