                {
                    "src": "/icons/shortcut-builder.png",
                    "sizes": "96x96",
                    "type": "image/png"
                }
            ]
        }
    ],
    "share_target": {
        "action": "/verify",
        "method": "POST",
        "enctype": "multipart/form-data",
        "params": {
            "title": "title",
            "text": "text",
            "url": "url",
            "files": [
                {
                    "name": "file",
                    "accept": [
                        "image/*",
                        "video/*",
                        "audio/*",
                        ".pdf"
                    ]
                }
            ]
        }
    },
    "related_applications": [],
    "prefer_related_applications": false,
    "protocol_handlers": [
        {
            "protocol": "web+stellarveriphy",
            "url": "/verify?id=%s"
        }
    ]
}