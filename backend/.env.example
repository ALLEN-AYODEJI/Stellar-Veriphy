# --- Server -------------------------------------------------------------
PORT=4000
LOG_LEVEL=info
# Bearer token for /admin/* operator endpoints. Admin endpoints are disabled when unset.
ADMIN_TOKEN=

# --- MongoDB ------------------------------------------------------------
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=stellarveriphy
# Commands slower than this are logged as "slow mongodb command" (0 disables).
MONGODB_SLOW_QUERY_MS=200

# --- Stellar ------------------------------------------------------------
STELLAR_NETWORK=testnet
# Optional override; defaults to the passphrase for STELLAR_NETWORK.
STELLAR_NETWORK_PASSPHRASE=
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
# Horizon is reported "degraded" when its latest ledger is older than this.
STELLAR_MAX_LEDGER_AGE_SECONDS=60

# --- Optional integrations (checked only when set) -----------------------
IPFS_API_URL=
KMS_HEALTH_URL=
ORACLE_HEALTH_URL=

# --- Health checks ------------------------------------------------------
HEALTH_CHECK_INTERVAL_MS=30000
HEALTH_CHECK_TIMEOUT_MS=5000
HEALTH_CHECK_RETRIES=2
# Comma-separated dependency names that gate /health/ready.
HEALTH_CRITICAL_DEPENDENCIES=mongodb

# --- Job queue ----------------------------------------------------------
JOB_CONCURRENCY=4
JOB_POLL_INTERVAL_MS=1000
JOB_HEARTBEAT_MS=10000
JOB_STALL_TIMEOUT_MS=60000
JOB_TIMEOUT_MS=300000
JOB_MAX_ATTEMPTS=5
JOB_RETRY_BASE_DELAY_MS=5000
JOB_RETRY_MAX_DELAY_MS=600000
JOB_RETRY_LOOP_THRESHOLD=3
JOB_MONITOR_INTERVAL_MS=15000

# --- Retention / cleanup (see docs/operations/data-retention.md) ---------
RETENTION_CLEANUP_ENABLED=true
RETENTION_INTERVAL_MINUTES=60
RETENTION_BATCH_SIZE=500
RETENTION_MAX_BATCHES_PER_RUN=20
RETENTION_IDLE_SESSION_HOURS=24
RETENTION_COMPLETED_SESSION_DAYS=7
RETENTION_ARCHIVE_DAYS=90
RETENTION_SUCCEEDED_JOB_DAYS=7
RETENTION_DEAD_JOB_DAYS=30
